{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "installCommand": "pip install -r requirements.txt && python deploy_setup.py",
      "functions": {
        "api/index.py": { "maxDuration": 60 }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install",
      "buildCommand": "pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 8 * * *" },
    { "path": "/api/cron/calendar", "schedule": "0 8 */2 * *" }
  ]
}
