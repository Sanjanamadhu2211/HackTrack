# Local dev only: where /api/* is proxied (the locally-running FastAPI app).
# On Vercel you run one project in services mode, so the top-level
# vercel.json rewrites route /api/* to the api service and API_ORIGIN
# must stay UNSET in production.
API_ORIGIN=http://localhost:8080
# Shows the email-only dev login on /login (the API must run with DEV_LOGIN=1)
NEXT_PUBLIC_DEV_LOGIN=1
