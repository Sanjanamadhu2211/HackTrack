# --- API (apps/api) ---
# Supabase direct PostgreSQL connection in production; local Docker Postgres here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hacktrack?sslmode=disable
# Public origin of the web app. Session cookies are Secure when this is https.
APP_BASE_URL=http://localhost:3000
# Google OAuth client (redirect URI: $APP_BASE_URL/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord Developer Portal credentials; all three are required to enable Discord.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Bearer token Vercel Cron (or an external scheduler) sends to all /api/cron/* routes
CRON_SECRET=
# Local only: enables POST /api/auth/dev-login (refused on https deployments)
DEV_LOGIN=1
PORT=8080
# Tests: any Postgres the test user may CREATE DATABASE on
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# --- Web (apps/web) ---
# Where Next.js proxies /api/* (the API's Vercel URL in production)
API_ORIGIN=http://localhost:8080
# Shows the email-only dev login on /login
NEXT_PUBLIC_DEV_LOGIN=1
# Optional: forwarded-email ingestion via a Mailgun inbound route
INBOUND_EMAIL_DOMAIN=
MAILGUN_SIGNING_KEY=
# Optional: AI extraction of pasted event descriptions (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional Google Calendar sync: base64-encoded random 32-byte key; keep it stable and secret.
CALENDAR_TOKEN_KEY=
